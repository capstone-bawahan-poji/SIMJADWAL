# Template for .env.production on the server. Copy, fill every <...>, never commit the real file.
#   cp .env.production.example .env.production
#   docker run --rm php:8.5-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"   # APP_KEY
#   openssl rand -hex 16    # REVERB_APP_KEY / REVERB_APP_SECRET, DB_PASSWORD

APP_NAME=SIMJADWAL
APP_ENV=production
APP_KEY=<base64:...>
APP_DEBUG=false
APP_HOST=<domain>
APP_URL=https://<domain>

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=simjadwal
DB_USERNAME=simjadwal
DB_PASSWORD=<strong-password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password>
MAIL_FROM_ADDRESS="<no-reply@domain>"
MAIL_FROM_NAME="${APP_NAME}"

# Used once by Reference/SuperadminSeeder (deploy.sh --seed). Remove the password after the first seed.
SUPERADMIN_EMAIL=<admin-email>
SUPERADMIN_PASSWORD=<strong-password>
# Password for accounts created without one. Never leave the code default.
ACCOUNT_DEFAULT_PASSWORD=<random-password>
SEED_KAPASITAS_RUANGAN=50
SEED_KAPASITAS_KELAS=50

SCHEDULING_PERIOD=2026/2027-GANJIL
GOTENBERG_URL=http://gotenberg:3000

# Reverb runs inside the app container (supervisord). PHP posts events to it locally.
REVERB_APP_ID=<random-id>
REVERB_APP_KEY=<random-key>
REVERB_APP_SECRET=<random-secret>
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# VITE_* are baked at image build from docker-compose.production.yml build args
# (REVERB_APP_KEY + APP_HOST, port 443, https). Changing them needs a rebuild.
